{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-module/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-module/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-module",
  "projects": {
    "api-management": {
      "type": "application",
      "root": "apps/api-management",
      "entryFile": "main",
      "sourceRoot": "apps/api-management/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-management/tsconfig.app.json"
      }
    },
    "api-module": {
      "type": "application",
      "root": "apps/api-module",
      "entryFile": "main",
      "sourceRoot": "apps/api-module/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-module/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    }
  }
}